# Required — set a NEW strong password (do not reuse any old shared password)
ADMIN_PASS=change-me-to-a-strong-unique-password

# Optional local override (Render sets PORT automatically)
PORT=8080

# Optional: keep updates after free-tier host restarts
# Create a private GitHub repo, add a fine-grained token with Contents: Read/Write
# GITHUB_TOKEN=
# GITHUB_REPO=your-github-username/tamara-hub-data
# GITHUB_PATH=hub_store.json
# GITHUB_BRANCH=main
